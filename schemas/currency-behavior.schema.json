{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "iso2",
      "supportsMultiCurrency",
      "settlementCurrency",
      "minorUnits",
      "updatedAt"
    ],
    "properties": {
      "iso2": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "supportsMultiCurrency": { "type": "boolean" },
      "settlementCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
      "cashRounding": { "type": "boolean" },
      "minorUnits": { "type": "integer" },
      "updatedAt": { "type": "string", "format": "date" }
    }
  }
}
